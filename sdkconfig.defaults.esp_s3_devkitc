# This file is used to pass DevKitC-1 options when building firmware for the probe
# To pass it to the build system, set the SDKCONFIG_DEFAULTS environment variable like so:
# export SDKCONFIG_DEFAULTS="sdkconfig.defaults.esp_devkitc;sdkconfig.defaults.esp32s3"

CONFIG_BRIDGE_PRODUCT_NAME="ESP-S3-DevKitC-1-USB-Bridge"

# Serial Bridge Pins (Safe broken-out GPIOs on DevKitC-1)
CONFIG_SERIAL_HANDLER_GPIO_BOOT=47
CONFIG_SERIAL_HANDLER_GPIO_RST=21
CONFIG_SERIAL_HANDLER_GPIO_RXD=18
CONFIG_SERIAL_HANDLER_GPIO_TXD=17

# JTAG Debug Probe Pins
CONFIG_DEBUG_PROBE_GPIO_TDI=7
CONFIG_DEBUG_PROBE_GPIO_TDO=6
CONFIG_DEBUG_PROBE_GPIO_TCK=5
CONFIG_DEBUG_PROBE_GPIO_TMS=4

# Addressable WS2812 RGB LED (GPIO48 on DevKitC-1)
CONFIG_BRIDGE_USE_RGB_LED=y
CONFIG_BRIDGE_GPIO_RGB_LED=48
CONFIG_BRIDGE_BRIGHTNESS_RGB_LED=20
